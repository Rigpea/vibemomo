# vibeMomo local companion (Atelier in the code) — copy to .env (gitignored) or set in your shell.
# Server
ATELIER_PORT=4747
# Durable studio data (memory, budget, registry). Default: <home>/.atelier
# ATELIER_DATA_DIR=C:\Users\you\.atelier
# Default folder where new projects are created. Default: parent folder of this repo.
# ATELIER_PROJECTS_DIR=C:\Users\you\Desktop\Projects
# Where the running server records {pid, platform, port, startedAt}. Default: .local/server.pid
# ATELIER_PID_FILE=C:\Users\you\Desktop\Projects\atelier\.local\server.pid
# Claude API key for BOUNDED utility tasks only (summaries, tagging, drafts).
# Never used for development work; never sent to the browser. Leave unset to run without API utilities.
# STUDIO_ANTHROPIC_API_KEY=sk-ant-...
